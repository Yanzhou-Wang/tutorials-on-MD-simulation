 LCHARG  =  .FALSE.
 LWAVE  =  .FALSE.
#start parameters for this Run (automatic defaults, hence not often required)
  ISTART = 0    #  job   : 0-new  1- orbitals from WAVECAR
  ICHARG = 2    #  charge: 1-file 2-atom 10-const

  KSPACING = 0.1
  KGAMMA = .TRUE.
  GGA = PE

#electronic optimization
  ENCUT = 600
  ALGO =  Normal    # alorithm for electron optimization, can be also FAST or ALL
  NELM = 120        # of ELM steps, sometimes default is too small 
  EDIFF = 1E-06
#! broadening and DOS related values; this works almost always
  SIGMA = 0.02; 
  ISMEAR =  0   #! broadening in eV, -4-tet -1-fermi 0-gaus
  PREC = Accurate
#ionic relaxation
#  EDIFFG =  -1E-04   # stopping-criterion for IOM (all forces smaller 1E-2)
  NSW = 1       # number of steps for IOM
  IBRION = -1        # CG for ions, often 1 (RMM-DISS) is faster
#  POTIM  =  .5       # step for ionic-motion (for MD in fs)
#performance optimization
